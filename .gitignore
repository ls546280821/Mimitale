# 依赖
node_modules/

# 安装依赖时使用的本地缓存（沙箱/镜像安装会产生）
.npm-cache/
.electron-cache/

# 打包输出（electron-builder 默认目录）
dist/
out/

# 本地数据：正常情况下这些文件在 %APPDATA%\Mimitale\，不在项目里。
# 这里再挡一层，防止有人把数据文件拷进项目目录后被误提交。
config.json
conversations.json
characters.json

# 角色卡目录里，只有仓库自带的样例卡该进版本库（被冒烟测试 / 例子里引用的
# 露西娅、露西诺、莉莉娅、林小雨、卡莉那几张），剩下都是自己导入、自己玩的
# 本地内容，不是项目代码。已经跟踪的文件不受 .gitignore 影响，所以这条只挡新文件。
# 确实要提交某一张时：git add -f "角色卡/xxx.json"
角色卡/*.json

# 编辑器 / 系统临时文件
*.bak
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# 冒烟测试的截图产物（--shot=<场景> 生成，用来肉眼核对界面）
tools/shots/

# WorkBuddy 的会话记忆目录（不属于项目代码）
.workbuddy/
